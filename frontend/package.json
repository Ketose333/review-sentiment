{
  "name": "review-sentiment-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preinstall": "npm run check:toolchain",
    "predev": "npm run check:toolchain && npm run check:env",
    "dev": "next dev",
    "check:env": "node scripts/check-env.mjs",
    "build": "npm run check:toolchain && npm run check:env && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "npm run check:toolchain && npm run check:env && node scripts/deploy.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.11",
    "vercel": "60.0.1"
  }
}
